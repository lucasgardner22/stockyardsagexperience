{% set start = event.eventStart %}
{% set end = event.eventEnd ?? start %}
{% set multiDay = end|date('Y-m-d') != start|date('Y-m-d') %}
{% set image = event.image.one() %}
{% set places = {
    stockyards: 'Stockyards Ag Experience',
    farmersMarket: 'Falls Park Farmers Market',
    stateFair: 'South Dakota State Fair',
} %}
{% set loc = event.eventLocation.value %}
{% set place = loc == 'custom' ? event.locationName : (places[loc] ?? '') %}

<a href="{{ event.url }}" class="group grid grid-cols-[4.5rem_1fr] md:grid-cols-[4.5rem_10rem_1fr_auto] gap-5 items-center bg-white rounded-lg p-3 font-body shadow-md transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-2xl">
    <div class="bg-brandBrownGreen text-brandOffWhite rounded-lg text-center py-2.5">
        <div class="text-xs uppercase tracking-widest">{{ start|date('M') }}</div>
        <div class="font-header font-bold text-3xl leading-none mt-1">{{ start|date('j') }}</div>
    </div>

    {% if image %}
        <img src="{{ image.url({ width: 360, height: 203, mode: 'crop' }) }}" alt="{{ image.alt ?: '' }}" class="hidden md:block w-full aspect-video object-cover rounded-lg {{ (past ?? false) ? 'opacity-80' }}" loading="lazy">
    {% endif %}

    <div class="{{ (past ?? false) ? 'opacity-80' }}">
        <h3 class="font-display text-2xl text-brandRed group-hover:underline">{{ event.title }}</h3>
        <p class="text-brandGray mt-1">
            {{ multiDay ? start|date('M j') ~ ' – ' ~ end|date('M j') : start|date('F j') }}
            {%- if not event.allDay %} · {{ start|date('g:i a')|replace({ am: 'a.m.', pm: 'p.m.' }) }}{% if event.eventEnd and not multiDay %} – {{ end|date('g:i a')|replace({ am: 'a.m.', pm: 'p.m.' }) }}{% endif %}{% endif %}
            {%- if place %} · {{ place }}{% endif %}
        </p>
        {% if event.eventCategories|length %}
            <div class="mt-3.5 flex flex-wrap gap-x-3 gap-y-1">
                {% for cat in event.eventCategories %}
                    <span class="text-xs uppercase tracking-widest text-brandBrownGreen">{{ cat.label }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <span class="hidden md:inline pr-3 text-sm uppercase tracking-widest text-brandBrownGreen">Details →</span>
</a>
