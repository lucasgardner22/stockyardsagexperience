{% set children = node.children.all() %}

<li class="relative group hover:text-brandOffWhite text-brandTan text-2xl">
    {% if node.url %}
        <a href="{{ node.url }}">{{ node.title }}</a>
    {% else %}
        <button type="button">{{ node.title }}</button>
    {% endif %}

    {% if children|length %}
        <div
            class="{{ alignRight ?? false ? 'right-0' : 'left-0' }} absolute top-full z-10 pt-3
            hidden group-hover:block group-focus-within:block"
        >
            <ul
                class="bg-brandTan min-w-max whitespace-nowrap p-5 rounded-md space-y-1.5 drop-shadow-lg
               border-t-8 border-t-brandBrownGreen text-lg font-normal"
            >
                {% for child in children %}
                    <li><a class="font-body hover:text-brandBlack text-brandBrownHover" href="{{ child.url }}">{{ child.title }}</a></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</li>
