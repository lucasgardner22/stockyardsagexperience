{% set image = family.image.one() %}
{% set posts = family.children.orderBy('postDate asc').all() %}

<article class="grid gap-8 md:grid-cols-[18rem_1fr] items-start py-12 border-b border-brandGray/30 last:border-0">
    {% if image %}
        <img
            src="{{ image.url({ width: 576, height: 432, mode: 'crop' }) }}"
            alt="{{ image.alt ?: family.title }}"
            class="w-full aspect-4/3 object-cover rounded-lg shadow-md"
            style="object-position: {{ image.getFocalPoint(true) }}"
        >
    {% endif %}

    <div>
        <h2 class="font-display text-3xl text-brandRed">
            <a href="{{ family.url }}" class="hover:underline">{{ family.title }}</a>
        </h2>

        <ul class="mt-4 space-y-2 font-body text-lg">
            {% for post in posts %}
                <li>
                    <a href="{{ post.url }}" class="text-brandBrownGreen hover:underline">
                        {{ family.title }} {{ loop.first ? 'Introduction' : 'Update' }}
                    </a>
                    <span class="text-brandGray">{{ post.postDate|date('F j, Y') }}</span>
                </li>
            {% else %}
                <li class="italic text-brandGray">First post coming soon!</li>
            {% endfor %}
        </ul>
    </div>
</article>
