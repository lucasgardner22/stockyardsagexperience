<!DOCTYPE html>
{% set navigation %}
    <nav>...</nav>
{% endset %}

<html lang="en-us">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ siteName }}</title>
        {{ craft.vite.script('src/js/app.js', false) }}
    </head>
    <body>
        <h1 class="bg-brandGreen text-4xl font-extrabold p-15">Stockyards AG Experience</h1>

        <ul>
            {% for item in navigation %}
            <li><a href="{{ item.href }}">{{ item.caption }}</a></li>
            {% endfor %}
        </ul>
    </body>
</html>