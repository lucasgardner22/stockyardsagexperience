{% extends '_layout/base' %}
{% block content %}
    <h1 class="bg-brandGreen text-4xl font-extrabold p-15">{{ entry.heroHeading }}</h1>

    <div>
        {{ entry.intro|nl2br }}
    </div>

    <ul>
        {% for item in navigation %}
            <li><a href="{{ item.href }}">{{ item.caption }}</a></li>
        {% endfor %}
    </ul>
{% endblock %}
