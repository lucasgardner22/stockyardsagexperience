{% extends '_layout/base' %}
{% set page = craft.entries.section('downForUpdates').one() %}

{% block content %}
    <div class="pt-15">
        {% if page %}
            {% for block in page.contentBuilder.all() %}
                {{ include('_blocks/' ~ block.type.handle, { block: block, noShadow: true }, with_context = false) }}
            {% endfor %}
        {% else %}
            <p class="text-center font-body text-lg py-10">The site is temporarily down for updates and maintenance. Sorry for the inconvenience!</p>
        {% endif %}
    </div>
{% endblock %}
