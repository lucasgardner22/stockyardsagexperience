<!DOCTYPE html>

<html lang="en-us">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ siteName }}</title>
        {{ craft.vite.script('src/js/app.js', false) }}
    </head>
    <body>
        <div class="flex bg-brandGreen items-baseline gap-15">
            {% set logoImage = siteSettings.stockyardsLogo.one() %}
                
            {% if logoImage %}
                <a href="{{ siteUrl }}"><img src="{{ logoImage.url }}" alt="{{ logoImage.title }}"></a>
            {% endif %}

            <nav aria-label="Main">
                {{ craft.navigation.render('mainNavigation') }}
            </nav>
        </div>
        {% block content %}
        {% endblock %}
    </body>
</html>
