<!DOCTYPE html>

<html lang="en-us">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ siteName }}</title>
        {{ craft.vite.script('src/js/app.js', false) }}
    </head>
    <body>
        // Add logo image from original stockyards site
        <div class="flex bg-brandGreen items-baseline g-15">
            <h1 class="text-4xl font-extrabold p-10 pl-15 pr-15">{{ siteSettings.heroHeading }}</h1>

            <nav aria-label="Main">
                {{ craft.navigation.render('mainNavigation') }}
            </nav>
        </div>
        {% block content %}
        {% endblock %}
    </body>
</html>
