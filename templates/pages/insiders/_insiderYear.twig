{% set families = entry.children.all() %}
{% set otherYears = entry.siblings.all() %}

{{ include('_blocks/imageBlock', { block: entry }, with_context = false) }}

<section class="max-w-5xl mx-auto px-5 py-10">
    {% if entry.body %}
        <div class="prose-h1:text-center prose-h1:font-header prose prose-lg mx-auto mt-6 font-body">{{ entry.body }}</div>
    {% endif %}

    <div class="mt-10">
        {% for family in families %}
            {{ include('_partials/insiderFamily', { family: family }, with_context = false) }}
        {% endfor %}
    </div>

    {% if otherYears|length %}
        <aside class="mt-15 text-center">
            <h2 class="font-header text-3xl pb-4">Ag Experience Insiders Continued</h2>
            <div class="italic pb-3 px-45">
                Interested in reading more Ag Experience Insiders? Click the links below to check out past Ag Experience Insider 
                families and learn what life is like on their operations! 
            </div>
            <ul class="mt-4 flex flex-col justify-center gap-4">
                {% for year in otherYears %}
                    <li><a href="{{ year.url }}" class="text-brandBrownGreen hover:underline">{{ year.title }}</a></li>
                {% endfor %}
            </ul>
        </aside>
    {% endif %}
</section>
