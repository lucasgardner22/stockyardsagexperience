{% extends '_layout/base' %}

{% set view = craft.app.request.getQueryParam('view') == 'calendar' ? 'calendar' : 'list' %}
{% set today = now|date('Y-m-d') %}

{% block content %}
    <div class="pt-30 pb-10 px-gutter max-w-5xl mx-auto">
        <h1 class="font-header font-bold text-5xl text-center">Events</h1>

        <div class="flex justify-center gap-2 my-8">
            {% for key, label in { list: 'List', calendar: 'Calendar' } %}
                <a
                    href="{{ key == 'list' ? url('events') : url('events', { view : 'calendar' }) }}"
                    class="px-4 py-1.5 rounded-full text-sm {{ view == key ? 'bg-brandBrownGreen text-brandOffWhite' : 'bg-brandTan text-brandBrown hover:bg-brandTanHover' }}"
                >{{ label }}</a>
            {% endfor %}
        </div>

        {% if view == 'list' %}
            {% set recent = craft.entries.section('events')
            .eventStart('>= ' ~ now|date_modify('-1 year')|date('Y-m-d'))
            .orderBy('eventStart asc')
            .with(['image'])
            .all() %}
            {% set upcoming = recent|filter(e => (e.eventEnd ?? e.eventStart)|date('Y-m-d') >= today) %}
            {% set past = recent|filter(e => (e.eventEnd ?? e.eventStart)|date('Y-m-d') < today)|reverse %}

            {% if upcoming|length %}
                <div class="grid gap-4">
                    {% for event in upcoming %}
                        {{ include('_partials/eventRow', { event: event }, with_context = false) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-center font-body text-lg py-10">New events are coming soon. Check back later!</p>
            {% endif %}

            {% if past|length %}
                <details class="mt-12">
                    <summary class="text-center cursor-pointer text-brandBrownGreen">Past Events</summary>
                    <div class="grid gap-4 mt-6 opacity-80">
                        {% for event in past %}
                            {{ include('_partials/eventRow', { event: event }, with_context = false) }}
                        {% endfor %}
                    </div>
                </details>
            {% endif %}

        {% else %}
            {% set month = craft.app.request.getQueryParam('month') %}
            {% set month = month matches '/^\\d{4}-\\d{2}$/' ? month : now|date('Y-m') %}
            {% set first = date(month ~ '-01') %}
            {% set nextFirst = first|date_modify('+1 month') %}
            {% set offset = first|date('w') %}

            {% set monthEvents = craft.entries.section('events')
            .eventStart(['and', '>= ' ~ first|date_modify('-2 months')|date('Y-m-d'), '< ' ~ nextFirst|date('Y-m-d')])
            .orderBy('eventStart asc')
            .with(['image'])
            .all()
            |filter(e => (e.eventEnd ?? e.eventStart)|date('Y-m-d') >= first|date('Y-m-d')) %}

            <div class="flex items-center justify-between mb-4">
                <a href="{{ url('events', { view: 'calendar', month: first|date_modify('-1 month')|date('Y-m') }) }}" class="text-2xl text-brandBrownGreen" aria-label="Previous month">←</a>
                <h2 class="font-display text-3xl text-brandRed">{{ first|date('F Y') }}</h2>
                <a href="{{ url('events', { view: 'calendar', month: nextFirst|date('Y-m') }) }}" class="text-2xl text-brandBrownGreen" aria-label="Next month">→</a>
            </div>

            {% set monthStart = first|date('Y-m-d') %}
            {% set monthEnd = nextFirst|date_modify('-1 day')|date('Y-m-d') %}
            {% set weeks = ((offset + first|date('t')) / 7)|round(0, 'ceil') %}

            <div class="hidden md:block text-sm">
                <div class="grid grid-cols-7 gap-1">
                    {% for d in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] %}
                        <div class="text-center text-brandBrownGreen pb-1">{{ d }}</div>
                    {% endfor %}
                </div>

                <div class="grid gap-1">
                    {% for w in 0..(weeks - 1) %}
                        {% set weekStart = first|date_modify((w * 7 - offset) ~ ' days') %}
                        {% set ws = weekStart|date('Y-m-d') %}
                        {% set we = weekStart|date_modify('+6 days')|date('Y-m-d') %}
                        {% set weekEvents = monthEvents|filter(e => e.eventStart|date('Y-m-d') <= we and (e.eventEnd ?? e.eventStart)|date('Y-m-d') >= ws) %}

                        <div class="relative">
                            <div class="absolute inset-0 grid grid-cols-7 gap-1">
                                {% for i in 0..6 %}
                                    {% set day = weekStart|date_modify(i ~ ' days')|date('Y-m-d') %}
                                    {% if day >= monthStart and day <= monthEnd %}
                                        <div class="bg-white rounded p-1.5 {{ day == today ? 'ring-2 ring-brandBrownGreen' }}">
                                            <div class="text-brandGray">{{ day|date('j') }}</div>
                                        </div>
                                    {% else %}
                                        <div></div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <div class="relative grid grid-cols-7 grid-flow-row-dense gap-x-1 gap-y-1 min-h-24 pt-7 pb-1.5 content-start">
                                {% for e in weekEvents %}
                                    {% set es = e.eventStart|date('Y-m-d') %}
                                    {% set ee = (e.eventEnd ?? e.eventStart)|date('Y-m-d') %}
                                    {% set segStart = max(es, ws, monthStart) %}
                                    {% set segEnd = min(ee, we, monthEnd) %}
                                    {% set col = date(segStart).diff(date(ws)).days + 1 %}
                                    {% set span = date(segEnd).diff(date(segStart)).days + 1 %}
                                    {% set contLeft = es < segStart %}
                                    {% set contRight = ee > segEnd %}
                                    <a
                                        href="{{ e.url }}"
                                        title="{{ e.title }}"
                                        style="grid-column: {{ col }} / span {{ span }}"
                                        class="truncate bg-brandBrownGreen text-brandOffWhite px-1.5 py-0.5 text-xs hover:bg-brandBrownGreenHover
                                              {{ contLeft ? 'rounded-l-none' : 'rounded-l ml-1.5' }} {{ contRight ? 'rounded-r-none' : 'rounded-r mr-1.5' }}"
                                    >
                                        {%- if contLeft %}← {% endif %}{{ e.title }}{% if contRight %} →{% endif -%}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="md:hidden grid gap-4">
                {% for event in monthEvents %}
                    {{ include('_partials/eventRow', { event: event }, with_context = false) }}
                {% endfor %}
            </div>

            {% if not monthEvents|length %}
                {% set nextUp = craft.entries.section('events').eventStart('>= ' ~ nextFirst|date('Y-m-d')).orderBy('eventStart asc').one() %}
                <p class="text-center font-body mt-6">
                    No events this month.
                    {% if nextUp %}Next up: <a href="{{ nextUp.url }}" class="text-brandRed underline">{{ nextUp.title }}</a>, {{ nextUp.eventStart|date('M j') }}.{% endif %}
                </p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
