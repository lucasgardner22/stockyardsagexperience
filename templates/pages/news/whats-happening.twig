{% extends '_layout/base' %}
{% set linkClass = 'min-w-10 h-10 px-3 inline-flex items-center justify-center rounded text-brandBrownGreen hover:bg-brandBrownGreen/10' %}
{% set currentClass = 'min-w-10 h-10 px-3 inline-flex items-center justify-center rounded bg-brandBrownGreen text-white font-bold' %}

{% block content %}
    {% set query = craft.entries.section('whatsHappening').orderBy('postDate desc').limit(10) %}

    {% paginate query as pageInfo, articles %}

    <section class="max-w-3xl mx-auto px-5 pb-15 pt-30">
        <h1 class="font-header font-bold text-5xl text-center pb-5">What's Happening</h1>

        {% for article in articles %}
            <article class="py-10 border-b border-brandGray/30 last:border-0">
                <h2 class="font-display text-3xl text-brandRed">
                    <a href="{{ article.url }}" class="hover:underline">{{ article.title }}</a>
                </h2>

                <p class="mt-1 text-sm text-brandGray">
                    <time datetime="{{ article.postDate|atom }}">{{ article.postDate|date('F j, Y') }}</time>
                    {% if article.byline %} · {{ article.byline }}{% endif %}
                </p>

                {% if article.summary %}
                    <p class="mt-4 font-body text-lg">{{ article.summary }}</p>
                {% endif %}

                <a href="{{ article.url }}" class="inline-block mt-4 text-sm uppercase tracking-widest text-brandBrownGreen hover:underline">
                    Read more →
                </a>
            </article>
        {% else %}
            <p class="mt-10 text-center italic text-brandGray">Nothing here yet — check back soon!</p>
        {% endfor %}

        {% if pageInfo.totalPages > 1 %}
            {% set pages = pageInfo.getDynamicRangeUrls(3) %}
            {% set firstInRange = pages|keys|first %}
            {% set lastInRange = pages|keys|last %}
        {% endif %}

        <nav aria-label="Article pages" class="mt-10 flex flex-wrap items-center justify-center gap-1 font-body">
            {% if firstInRange > 1 %}
                <a href="{{ pageInfo.firstUrl }}" class="{{ linkClass }}">1</a>
                {% if firstInRange > 2 %}<span class="px-1 text-brandGray">…</span>{% endif %}
            {% endif %}

            {% for page, url in pages %}
                {% if page == pageInfo.currentPage %}
                    <span class="{{ currentClass }}" aria-current="page">{{ page }}</span>
                {% else %}
                    <a href="{{ url }}" class="{{ linkClass }}">{{ page }}</a>
                {% endif %}
            {% endfor %}

            {% if lastInRange < pageInfo.totalPages %}
                {% if lastInRange < pageInfo.totalPages - 1 %}<span class="px-1 text-brandGray">…</span>{% endif %}
                <a href="{{ pageInfo.lastUrl }}" class="{{ linkClass }}">{{ pageInfo.totalPages }}</a>
            {% endif %}
        </nav>
    </section>
{% endblock %}
