{% extends '_layouts/blockWrapper.twig' %}
{% import '_templates/components/card.twig' as Card %}

{% block blockWrapper %}
   <div class="flex flex-col lg:flex-row items-center gap-16 block-container">
      <div class="prose lg:w-1/2">
         <h1>{{ block.title }}</h1>
         {{ block.richText }}
      </div>
      <div class="lg:w-1/2 grid gap-6 rounded grid-cols-1 sm:grid-cols-2 sm:py-24">
         {% set facts = block.factFields.all() %}
         <div class="flex flex-col gap-6 sm:-translate-y-16">
            {% if facts[0] is defined %}
               {{ Card.fact(facts[0].number, facts[0].numberLabel, facts[0].fact) }}
            {% endif %}
            {% if facts[1] is defined %}
               {{ Card.fact(facts[1].number, facts[1].numberLabel, facts[1].fact) }}
            {% endif %}
         </div>
         <div class="flex flex-col gap-6 sm:translate-y-16">
            {% if facts[2] is defined %}
               {{ Card.fact(facts[2].number, facts[2].numberLabel, facts[2].fact) }}
            {% endif %}
            {% if facts[3] is defined %}
               {{ Card.fact(facts[3].number, facts[3].numberLabel, facts[3].fact) }}
            {% endif %}
         </div>
         <div></div>
      </div>
   </div>
{% endblock %}