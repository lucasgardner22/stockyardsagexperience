{% extends '_layout/base' %}
{% set linkClass = 'min-w-10 h-10 px-3 inline-flex items-center justify-center rounded text-brandBrownGreen hover:bg-brandBrownGreen/10' %}
{% set currentClass = 'min-w-10 h-10 px-3 inline-flex items-center justify-center rounded bg-brandBrownGreen text-white font-bold' %}

{% block content %}
    {% set q = craft.app.request.getQueryParam('q')|trim %}

    <section class="max-w-3xl mx-auto px-5 pb-15 pt-30">
        <h1 class="font-header font-bold text-5xl text-center pb-5">Search</h1>

        <form action="{{ url('search') }}" method="get" role="search" class="flex gap-2 mb-10">
            <label for="search-page" class="sr-only">Search the site</label>
            <input
                id="search-page"
                type="search"
                name="q"
                value="{{ q }}"
                required
                placeholder="Search the site…"
                class="flex-1 rounded border border-brandGray/40 px-4 py-3 font-body"
            >
            <button type="submit" class="rounded bg-brandBrownGreen px-6 py-3 font-body uppercase tracking-widest text-sm text-white hover:opacity-90">Search</button>
        </form>

        {% if q %}
            {% set query = craft.entries
                .section(['pages', 'whatsHappening', 'insiders'])
                .uri(':notempty:')
                .search(q)
                .orderBy('score')
                .limit(10) %}

            {% paginate query as pageInfo, results %}

            <p class="text-brandGray font-body">
                {{ pageInfo.total }} {{ pageInfo.total == 1 ? 'result' : 'results' }} for “{{ q }}”
            </p>

            {% for result in results %}
                <article class="py-8 border-b border-brandGray/30 last:border-0">
                    <p class="text-sm uppercase tracking-widest text-brandBrownGreen">{{ result.section.name }}</p>
                    <h2 class="font-display text-2xl text-brandRed mt-1">
                        <a href="{{ result.url }}" class="hover:underline">{{ result.title }}</a>
                    </h2>
                    {% if result.section.handle != 'pages' %}
                        <p class="mt-1 text-sm text-brandGray">{{ result.postDate|date('F j, Y') }}</p>
                    {% endif %}
                    {% set summary = result.summary ?? null %}
                    {% if summary %}
                        <p class="mt-3 font-body">{{ summary }}</p>
                    {% endif %}
                </article>
            {% else %}
                <p class="mt-10 text-center italic text-brandGray">Nothing matched “{{ q }}”. Try a different word, or check the spelling.</p>
            {% endfor %}

            {% if pageInfo.totalPages > 1 %}
                <nav aria-label="Search result pages" class="mt-10 flex flex-wrap items-center justify-center gap-1 font-body">
                    {% for page, url in pageInfo.getDynamicRangeUrls(3) %}
                        {% if page == pageInfo.currentPage %}
                            <span class="{{ currentClass }}" aria-current="page">{{ page }}</span>
                        {% else %}
                            <a href="{{ url }}" class="{{ linkClass }}">{{ page }}</a>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
