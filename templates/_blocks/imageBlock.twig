{% set image = block.image.one() %}

{% if image %}
    <figure>
        <div class="relative">
            <img class="w-full h-100 object-cover relative z-0" src="{{ image.url }}" alt="{{ image.alt }}">

            {% if block.overlayText %}
                <div class="absolute inset-0 bg-brandBlack/30"></div>

                <div class="absolute inset-0 flex flex-col justify-center pl-15">
                    <h2 class="text-7xl text-brandTan font-header drop-shadow-lg/75 drop-shadow-brandBlack">
                        {{ block.overlayText }}
                    </h2>
                </div>
            {% endif %}
        </div>
        
        {% if block.caption %}
            <figcaption class="flex items-center justify-center gap-2 italic text-brandGray">
                {% if block.captionArrow %}
                    {{ svg('@appicons/' ~ block.captionArrow.name ~ '.svg', class = 'inline w-3 h-3 fill-current') }}
                {% endif %}

                {{ block.caption }}
            </figcaption>
        {% endif %}
    </figure>
{% endif %}
