{% set image = block.image.one() %}

{% if image %}
    {% set focalPoint = image.getFocalPoint(true) %}
    {% set zoom = block.zoom ?: 1 %}
    
    <figure class="pb-5">
        <div class="relative">
            <img class="w-full h-100 overflow-hidden object-cover block" style="object-position: {{ focalPoint }}; transform-origin: {{ focalPoint }}; scale: {{ zoom }};" src="{{ image.getUrl({ width: 2400, mode: 'fit' }) }}" alt="{{ image.alt }}">

            {% if block.overlayText %}
                <div class="absolute inset-0 bg-brandBlack/30"></div>
                <div class="absolute inset-0 bg-linear-to-r {#to-t instead of to-r#} from-brandRed/75 to-transparent"></div>

                <div class="absolute inset-0 flex {#items-center instead of flex-col#} flex-col justify-center pl-25 {#or no pl-25#}">
                    <h2 class="text-7xl text-brandTan font-header drop-shadow-lg/75 drop-shadow-brandBlack">
                        {{ block.overlayText }}
                    </h2>
                </div>
            {% endif %}
        </div>
        
        {% if block.caption %}
            <figcaption class="flex items-center justify-center gap-2 italic text-brandGray">
                {% if block.captionArrow %}
                    {{ svg('@appicons/' ~ block.captionArrow.name ~ '.svg', class = 'inline w-3 h-3 fill-current') }}
                {% endif %}

                {{ block.caption }}
            </figcaption>
        {% endif %}
    </figure>
{% endif %}
