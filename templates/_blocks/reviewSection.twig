{% set reviewBlock = block.reviewArray.all() %}

<section class="mt-10 bg-brandBrownGreen" data-review-cycle data-interval="6000">
    <div class="pt-10 text-center text-4xl font-header text-white ">
        {{ block.title }}
    </div>
    <div class="grid px-35 pb-15 pt-10">
        {% for group in reviewBlock|batch(3) %}
            <div
                data-review-page
                class="col-start-1 row-start-1 grid md:grid-cols-3 gap-5 transition-opacity duration-700
                    {{ loop.first ? 'opacity-100' : 'opacity-0 pointer-events-none' }}"
                {{ loop.first ? '' : 'inert' }}
            >

                {% for review in group %}
                    {% set image = review.image.one() %}

                    <div class="flex items-center bg-white rounded-lg">
                        <div class="flex flex-col p-10 justify-center">
                            <div class="prose">{{ review.body }}</div>
        
                            <p class="flex font-bold items-center pt-5">
                                {% if image %}
                                    <img class="h-7.5 pr-5" src="{{ image.url }}" alt="">
                                {% endif %}
                                
                                {{ review.username }}
                            </p>
                        </div>
                    </div>
                {% endfor %}

            </div>
        {% endfor %}
    </div>
</section>
