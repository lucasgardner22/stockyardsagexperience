{% set inColumn = inColumn ?? false %}
{% set inProse = inProse ?? false %}

{% if block.buttonLink.url %}
    {{ include('_partials/button', {
            text: block.buttonText ?: block.buttonLink.label,
            url: block.buttonLink.url,
            target: block.buttonLink.target,
            variant: block.buttonStyle.value,
            align: inProse or inColumn ? 'left' : 'center',
            class: inProse ? 'not-prose my-6' : (inColumn ? 'mt-6 px-gutter' : 'mt-10 px-5')
        }, with_context = false) }}
    </div>
{% endif %}
