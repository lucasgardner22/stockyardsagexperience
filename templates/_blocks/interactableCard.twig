{% set image = block.image.one() %}

{% if image %}
    <div class="flex justify-center {{ inColumn ? '' : 'my-10 px-5' }}">
        {% if block.imageUrl %}
            <a href="{{ block.imageUrl }}"><img class="w-full aspect-4/3 object-cover rounded-lg shadow-md transition duration-300 ease-in-out hover:scale-105 hover:shadow-2xl" src="{{ image.getUrl }}" alt="{{ image.title }}"></a>
        {% else %}
            <img class="w-full aspect-4/3 object-cover rounded-lg shadow-md transition duration-300 ease-in-out hover:scale-105 hover:shadow-2xl" src="{{ image.getUrl }}" alt="{{ image.title }}">
        {% endif %}

        {% if block.overlayTitle %}
            <div class="absolute inset-0 bg-brandBlack/30"></div>

            <h2 class="text-7xl text-brandTan font-header drop-shadow-lg/75 drop-shadow-brandBlack">
                {{ block.overlayTitle }}
            </h2>
        {% endif %}
    </div>
{% endif %}
