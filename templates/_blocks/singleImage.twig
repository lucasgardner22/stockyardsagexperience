{% set image = block.image.one() %}

{% if image %}
    <figure class="{{ inProse ?? false ? 'not-prose my-8' : '' }}">
        {% set framed = (inColumn ?? false) or (inProse ?? false) %}

        <img class="{{ framed ? 'block w-full aspect-video object-cover shadow-md' : 'mx-auto mt-15 max-h-175' }}" src="{{ image.url }}" alt="{{ image.title }}">
        {{ include('_partials/caption', { caption: block.caption, arrow: block.captionArrow }, with_context = false) }}
    </figure>
{% endif %}
