{% set columns = block.columns.all() %}
{% set doubleCard = (columns|first).type.handle == 'interactableCard' and (columns|last).type.handle == 'interactableCard' %}

<div class="{{ doubleCard ? 'px-25' : 'px-0' }} grid md:grid-cols-2 items-center pt-10">
    {% for column in columns %}
        {% set isText = column.type.handle == 'textBlock' %}

        <div class="{{ isText ? 'px-gutter pt-10' : '' }}">
            {{ include('_blocks/' ~ column.type.handle, { block: column, inColumn: true, fillHeight: true }, with_context = false) }}
        </div>
    {% endfor %}
</div>
