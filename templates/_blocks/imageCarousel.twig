{% set images = block.images.all() %}

{% if images|length %}
    {% set ratios = images|filter(image => image.width and image.height)|map(image => image.width / image.height) %}

    {% set ratio = ratios|length ? max(ratios) : 16 / 9 %}

    {% set slideWidth = 1600 %}
    {% set slideHeight = (slideWidth / ratio)|round %}

    <div class="swiper [--swiper-theme-color:var(--color-brandTan)]" data-carousel {% if block.autoplay %}data-autoplay="true"{% endif %}>
        <div class="swiper-wrapper">
            {% for image in images %}
                <div class="swiper-slide">
                    <img
                        src="{{ image.url({ width: slideWidth, height: slideHeight, mode: 'crop' }) }}"
                        width="{{ slideWidth }}"
                        height="{{ slideHeight }}"
                        alt="{{ image.alt }}"
                        loading="{{ loop.first ? 'eager' : 'lazy' }}"
                        class="w-full h-auto"
                    >
                </div>
            {% endfor %}
        </div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-pagination"></div>
    </div>
{% endif %}
