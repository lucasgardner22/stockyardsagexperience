{% set images = block.images.all() %}

{% if images|length %}
    <div class="swiper [--swiper-theme-color:var(--color-brandTan)]" data-carousel {% if block.autoplay %}data-autoplay="true"{% endif %}>
        <div class="swiper-wrapper">
            {% for image in images %}
                <div class="swiper-slide">
                    <div class="flex items-center justify-center h-180 md:h-180 py-8 bg-brandBrownGreen">
                        <img
                            src="{{ image.url({ width: 1200, height: 800, mode: 'fit' }) }}"
                            alt="{{ image.alt }}"
                            loading="lazy"
                            class="w-auto h-full max-w-full object-contain"
                        >
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
        <div class="swiper-pagination"></div>
    </div>
{% endif %}
