{% set images = block.images.all() %}

<div class="mt-15">
    {% if block.title %}
        <div class="flex font-display font-bold text-white bg-brandBrownGreen pt-8 text-5xl justify-center">
            {{ block.title }}
        </div>
    {% endif %}

    {% if images|length %}
        <div class="swiper [--swiper-theme-color:var(--color-brandTan)]" data-carousel {% if block.autoplay %}data-autoplay="true"{% endif %}>
            <div class="swiper-wrapper">
                {% for image in images %}
                    <div class="swiper-slide">
                        <div class="bg-brandBrownGreen">
                            <div class="flex gap-25 ml-30 mr-30 items-center justify-center h-180 md:h-180 py-8">
                                <div class="relative h-full shrink-0">
                                    <img
                                        src="{{ image.url({ width: 1200, height: 800, mode: 'crop' }) }}"
                                        alt="{{ image.alt }}"
                                        loading="lazy"
                                        class="block w-auto h-full aspect-3/2 shrink-0 object-cover"
                                    >

                                    {% if block.showTitles %}
                                        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>

                                        <div
                                            class="absolute bottom-20 left-20 text-shadow-lg text-shadow-black/90 font-body text-brandTan text-4xl"
                                        >{{ image.title }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-pagination"></div>
        </div>
    {% endif %}
</div>

