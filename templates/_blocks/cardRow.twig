{% import '_macros/section.twig' as section %}

{% set background = block.sectionBackground.value %}
{% set cards = block.cards.all() %}

{% if cards|length %}
    <section class="px-gutter pb-12 {{ section.bg(background) }} {{ not background ? "pt-0" : "pt-12" }}">
        {% if block.title %}
            <h2 class="font-header font-bold text-3xl text-center mb-10">{{ block.title }}</h2>
        {% endif %}

        {# Size columns to the card count (max 3 per row) and center any partial row #}
        {% set count = cards|length %}
        {% set itemWidth = {
            1: 'md:basis-full',
            2: 'md:basis-[calc((100%-2rem)/2)]',
        }[count] ?? 'md:basis-[calc((100%-4rem)/3)]' %}
        {% set rowWidth = {
            1: 'max-w-3xl',
            2: 'max-w-6xl',
        }[count] ?? 'max-w-8xl' %}

        <div class="flex flex-wrap justify-center gap-8 mx-auto {{ rowWidth }}">
            {% for card in cards %}
                <div class="w-full {{ itemWidth }}">
                    {{ include('_blocks/interactableCard', { block: card, inColumn: true, keepRatio: block.keepAspectRatio }, with_context = false) }}
                </div>
            {% endfor %}
        </div>
    </section>
{% endif %}
